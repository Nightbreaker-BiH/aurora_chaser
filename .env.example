PORT=3000
POLL_MINUTES=15
NASA_API_KEY=DEMO_KEY

# SMTP is optional. Subscriptions are stored even if SMTP is not configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AuroraChaser <alerts@example.com>"

# Cloudflare Worker email delivery via Resend
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
ADMIN_TEST_TOKEN=
