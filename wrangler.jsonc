{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aurora-chaser",
  "main": "src/worker.js",
  "compatibility_date": "2026-03-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "POLL_MINUTES": "15",
    "TIMEZONE": "Europe/Sarajevo",
    "DARK_ALTITUDE_DEG": "-12",
    "EVALUATION_HOURS": "18"
  },
  "observability": {
    "enabled": true
  }
  // Set secrets with Wrangler before production deploy:
  // - wrangler secret put NASA_API_KEY
}
